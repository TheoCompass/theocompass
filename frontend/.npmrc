# @cloudflare/next-on-pages@1 declares a peer of @cloudflare/workers-types@^4,
# while the latest `wrangler` (which `npx` pulls in transitively on each
# Cloudflare Pages build) peers @cloudflare/workers-types@^5. npm's strict
# peer resolution then aborts the build with ERESOLVE.
#
# This restored the build after Cloudflare Pages started failing on
# 2026-11-07, with no change to the Pages dashboard settings required.
legacy-peer-deps=true
