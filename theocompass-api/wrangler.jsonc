/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "theocompass-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-01",
	"observability": {
		"enabled": true
	},
	// --- BIND OUR D1 DATABASE ---
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "theocompass-db",
			"database_id": "256b4e36-633c-46fa-8ec7-9e79eba91823" // Replace with your actual D1 ID
		}
	],
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "THEOCOMPASS_CACHE",
			"id": "605f8a8e45d54233ac6239194fcaa29e",
			"remote": true
		}
	],

	// --- ISSUE REPORT NOTIFICATIONS (see docs/DEVELOPER_GUIDE.md §11) ---
	// The in-quiz "Report" flag always stores its row in D1; this binding only
	// adds the courtesy email. `wrangler deploy` refuses a `destination_address`
	// that is not a verified Email Routing address, so it stays on only while
	// both of these are true: the zone has Email Routing enabled (MX
	// route1-3.mx.cloudflare.net, SPF include:_spf.mx.cloudflare.net) and
	// theocompass.project@gmail.com is listed and verified under
	// Email Routing -> Destination addresses. If that changes, a deploy fails
	// loudly here rather than the notification failing quietly at runtime.
	"send_email": [
		{
			"name": "FLAG_EMAIL",
			"destination_address": "theocompass.project@gmail.com"
		}
	],

	// --- STAGING ENVIRONMENT (Phase 0) ---
	// 1) npx wrangler d1 create theocompass-db-staging
	// 2) npx wrangler kv namespace create THEOCOMPASS_CACHE --env staging
	// 3) Uncomment the block below, paste the IDs, add a trailing comma after
	//    the kv_namespaces array above, then: npx wrangler deploy --env staging
	/*
	"env": {
		"staging": {
			"name": "theocompass-api-staging",
			"d1_databases": [
				{ "binding": "DB", "database_name": "theocompass-db-staging", "database_id": "PASTE_STAGING_D1_ID" }
			],
			"kv_namespaces": [
				{ "binding": "THEOCOMPASS_CACHE", "id": "PASTE_STAGING_KV_ID", "remote": true }
			]
		}
	},
	*/
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}